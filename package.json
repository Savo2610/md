{
  "name": "md",
  "version": "1.0.0",
  "private": true,
  "description": "Markdown-Editor auf md.veerka.mp",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "dev": "node tools/build.mjs && concurrently -k -n client,worker \"node tools/build.mjs --watch\" \"wrangler dev --port ${PORT:-8790}\"",
    "typecheck": "tsc -p . && tsc -p tsconfig.client.json",
    "test": "node tools/test-api.mjs",
    "deploy": "node tools/build.mjs && wrangler deploy"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.1",
    "codemirror": "^6.0.2",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "lib0": "^0.2.120",
    "markdown-it": "^15.0.3",
    "markdown-it-abbr": "^2.0.0",
    "markdown-it-anchor": "^10.1.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-front-matter": "^0.2.4",
    "markdown-it-ins": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "mermaid": "^12.3.0",
    "turndown": "^7.2.5",
    "y-codemirror.next": "^0.3.6",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@types/markdown-it": "^14.2.0",
    "@types/turndown": "^5.0.6",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.160.0"
  }
}
